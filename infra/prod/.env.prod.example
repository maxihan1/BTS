# BTS 프로덕션 환경변수 템플릿 — 복사해서 채운다: cp .env.prod.example .env && vi .env
# 실제 .env 와 secrets/ 는 커밋 금지 (.gitignore). 값은 서버에서만 관리.

# ── DB (bts-postgres) ────────────────────────────────────────────────────────
BTS_DB_NAME=bts
BTS_DB_USERNAME=bts
BTS_DB_PASSWORD=CHANGE_ME_strong_db_password

# ── JWT 자체 발급 (PemFileKeyProvider @Profile(prod)) ────────────────────────
# issuer-uri = 공개 접속 URL (JWT iss 클레임 + /.well-known/jwks.json 기반). 예: https://bts.example.com
BTS_AUTH_ISSUER_URI=https://bts.example.com
# RSA 개인키 PEM 컨테이너 내부 경로 (compose 가 infra/secrets/bts-jwt.pem 을 여기로 마운트)
# 키 생성: openssl genrsa -out infra/secrets/bts-jwt.pem 2048
BTS_JWT_PRIVATE_KEY_PATH=/secrets/bts-jwt.pem

# ── MinIO (bts-minio, 첨부 스토리지) ─────────────────────────────────────────
BTS_MINIO_ACCESS_KEY=CHANGE_ME_minio_access
BTS_MINIO_SECRET_KEY=CHANGE_ME_minio_secret
BTS_MINIO_BUCKET=bts-attachments

# ── WebAuthn (FR-MF-03 보안키) ───────────────────────────────────────────────
# RP ID = 등록 도메인(포트 제외). ORIGIN = https 스킴 포함 공개 URL.
BTS_WEBAUTHN_RP_ID=bts.example.com
BTS_WEBAUTHN_RP_NAME=BTS
BTS_WEBAUTHN_ORIGIN=https://bts.example.com

# ── CORS (프론트 공개 오리진, 쉼표 구분) ─────────────────────────────────────
BTS_CORS_ALLOWED_ORIGINS=https://bts.example.com

# ── 부트스트랩 관리자 (최초 1회 시드) ────────────────────────────────────────
BTS_BOOTSTRAP_ADMIN_USERNAME=admin

# ── 알림 이메일 (선택 — 미설정 시 기본값) ────────────────────────────────────
BTS_NOTIFICATION_EMAIL_FROM=no-reply@bts.example.com
# BTS_MAIL_HOST / BTS_MAIL_PORT — SMTP 서버 (미설정 시 compose 기본 bts-mailhog:1025 참조; 실제 SMTP 로 교체)

# ── LDAP (선택 — LDAP 인증 사용 시) ──────────────────────────────────────────
# BTS_LDAP_URL=ldap://ldap.example.com:389
# BTS_LDAP_BASE_DN=dc=example,dc=com
# BTS_LDAP_BIND_DN=cn=admin,dc=example,dc=com
# BTS_LDAP_BIND_PASSWORD=CHANGE_ME

# ── 암호화 키 (SecretEncryptor — AES-256-GCM) ────────────────────────────────
# ★ 미설정이어도 부팅은 통과하고 /actuator/health 도 green 이다.
#   BTS_AUTH_ISSUER_URI 처럼 기동 즉시 fail-fast 하지 않는다 — 검증이 "사용 시점"으로
#   미뤄져 있어 해당 기능을 처음 호출할 때 500 이 난다 (MFA·OIDC 에서 실제로 터진 사고).
#   → 배포 후 스모크 점검은 health 가 아니라 실기능 경로(MFA 등록 등)로 해야 잡힌다.
# ★ salt 는 반드시 hex 문자열 (Encryptors.stronger 가 hex 로 디코드한다).
#   키 생성:   openssl rand -base64 32
#   salt 생성: openssl rand -hex 32
# BC 마다 서로 다른 키/salt 를 쓴다 (키 위생 — 한 도메인 유출이 다른 도메인으로 전파되지 않음).

# MFA TOTP secret 암호화 (FR-MF-01) — 미설정 시 MFA 등록/검증 첫 호출 500
BTS_MFA_ENCRYPTION_KEY=CHANGE_ME_mfa_encryption_key
BTS_MFA_ENCRYPTION_SALT=CHANGE_ME_mfa_hex_salt

# OIDC client_secret 암호화 (FR-AU-04) — 미설정 시 OIDC 설정/로그인 첫 호출 500
BTS_OIDC_ENCRYPTION_KEY=CHANGE_ME_oidc_encryption_key
BTS_OIDC_ENCRYPTION_SALT=CHANGE_ME_oidc_hex_salt

# 아웃바운드 웹훅 secret 암호화 (FR-API-03) — 미설정 시 웹훅 등록/발송 첫 호출 500
# 프로퍼티는 하이픈 표기다 (bts.webhook-encryption.{key,salt} — WebhookEncryptionConfig.kt:51,54).
BTS_WEBHOOK_ENCRYPTION_KEY=CHANGE_ME_webhook_encryption_key
BTS_WEBHOOK_ENCRYPTION_SALT=CHANGE_ME_webhook_hex_salt

# ── Slack 연동 (FR-SL-01, 선택 — Slack 앱 사용 시) ───────────────────────────
# 값은 Slack 앱 콘솔(api.slack.com/apps)에서 발급. Slack 을 쓰지 않으면 주석 유지.
# 미설정 시 인바운드(/slack/events·commands·interactions)는 서명 검증이 fail-closed 로
# 동작해 전부 401 이다 — 안전하지만 Slack 연동 기능은 정지한다.
# BTS_SLACK_SIGNING_SECRET=CHANGE_ME_slack_signing_secret
# BTS_SLACK_CLIENT_ID=CHANGE_ME_slack_client_id
# BTS_SLACK_CLIENT_SECRET=CHANGE_ME_slack_client_secret
# BTS_SLACK_REDIRECT_URI=https://bts.example.com/slack/install/callback
# OAuth state HMAC 서명 키 — 설치 플로우의 state 위변조 방지
# BTS_SLACK_STATE_KEY=CHANGE_ME_slack_state_key
# 봇 토큰 암호화 — 위 SecretEncryptor 규칙과 동일 (salt 는 hex)
# BTS_SLACK_ENCRYPTION_KEY=CHANGE_ME_slack_encryption_key
# BTS_SLACK_ENCRYPTION_SALT=CHANGE_ME_slack_hex_salt

# ── Git 웹훅 (FR-AT-07, 선택 — GitHub/GitLab 연동 시) ─────────────────────────
# PR 머지 트리거(TriggerType.PR_MERGED)용. GitHub/GitLab 을 쓰지 않으면 주석 유지.
# 웹훅 등록 시 저장하는 secret 을 암호화한다 — 위 SecretEncryptor 규칙과 동일 (salt 는 hex).
#   키 생성:   openssl rand -base64 32
#   salt 생성: openssl rand -hex 32
# 미설정 시 부팅/health 는 통과하고 웹훅 secret 저장·검증 첫 호출에서 500 이다.
# BTS_AUTOMATION_ENCRYPTION_KEY=CHANGE_ME_automation_encryption_key
# BTS_AUTOMATION_ENCRYPTION_SALT=CHANGE_ME_automation_hex_salt
