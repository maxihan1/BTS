# 젠킨스 환경변수 — 실제 값은 `.env` 에 둔다 (gitignored)
#
# 사용. cp .env.example .env && vi .env  →  ./bootstrap.sh up
#
# ★`NODE_VERSION` 과 `DOCKER_GID` 는 여기 적지 않는다. bootstrap.sh 가 `.nvmrc` 와
#   `getent group docker` 에서 **읽어서** 넘긴다 — 손으로 적으면 그 순간 두 번째 목록이 된다.

# 관리자 계정. 비밀번호는 사람이 직접 채운다.
JENKINS_ADMIN_ID=maxi
JENKINS_ADMIN_PASSWORD=
JENKINS_ADMIN_EMAIL=gwalho@gmail.com
