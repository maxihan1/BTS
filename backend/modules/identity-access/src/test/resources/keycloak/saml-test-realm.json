{
  "realm": "saml-test",
  "enabled": true,
  "displayName": "BTS SAML Test Realm",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "bts-saml-sp",
      "name": "BTS SAML Service Provider (test)",
      "enabled": true,
      "protocol": "saml",
      "publicClient": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:*/login/saml2/sso/bts-keycloak"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.authnstatement": "true",
        "saml_name_id_format": "username",
        "saml_assertion_consumer_url_post": "http://localhost:8080/login/saml2/sso/bts-keycloak",
        "saml_single_logout_service_url_post": "http://localhost:8080/logout/saml2/slo",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_force_name_id_format": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "friendly.name": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "displayName",
          "protocol": "saml",
          "protocolMapper": "saml-javascript-mapper",
          "consentRequired": false,
          "config": {
            "single": "true",
            "friendly.name": "displayName",
            "attribute.name": "displayName",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@bts.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "BTS",
      "credentials": [
        {
          "type": "password",
          "value": "Test1234!",
          "temporary": false
        }
      ]
    }
  ]
}
