# jOOQ generated 소스 — ktlint naming 룰 제외 (DefaultCatalog의 PUBLIC, Public.kt의 routine 함수명 등)
# PostgreSQL 컬럼/함수명이 SCREAMING_SNAKE → Kotlin convention 강제 불가
root = false

[**.kt]
ktlint_standard_property-naming = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_class-naming = disabled
ktlint_standard_filename = disabled
