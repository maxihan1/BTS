{
  "name": "bts-monorepo",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "BTS (Project Atlas) — 사내 1,000명 규모 협업 워크스페이스.",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "classify": "node scripts/workflow/classify-task.ts",
    "test:workflow": "node --test scripts/workflow/*.test.ts",
    "dev": "pnpm -r run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "prepare": "husky",
    "verify": "pnpm -r run lint && pnpm -r run typecheck && pnpm -r run test && pnpm -r run build"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^17.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
